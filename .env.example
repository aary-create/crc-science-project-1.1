# Every variable here is optional. With none set, the app still runs fully:
# alerts (SACHET + IMD), location search, hospitals, the map, live weather,
# air quality and the 7-day outlook are all keyless.
# Put real values in Vercel → Project → Settings → Environment Variables,
# never in this file or the repo.

# --- Database (Vercel → Storage → Create Database → Neon → Connect) --------
# Persists user profiles and ESP32 node pings between restarts. Required for
# SMS / WhatsApp / email subscriptions.
DATABASE_URL=

# --- "Explain this alert simply" (AI rewrite; glossary works without it) ----
# Free, no card: console.groq.com → API Keys. Used first if set.
GROQ_API_KEY=
# Paid opt-in: console.anthropic.com → API Keys. Used only if GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=
# Optional model overrides if a provider retires the default model.
GROQ_MODEL=
ANTHROPIC_MODEL=

# --- Signed QR relays (phone-to-phone, offline) -----------------------------
# Generate with `npm run relay-key` and paste the whole PEM block.
# Without it relays still work but show as "unverified".
RELAY_SIGNING_KEY=

# --- ESP32 nodes -------------------------------------------------------------
# If set, nodes must send the same value (NODE_TOKEN in the firmware).
ESP32_NODE_TOKEN=

# --- SMS / WhatsApp / email alerts (all optional, each needs an account) ----
# Protects /api/dispatch; the scheduler sends it as "Authorization: Bearer ...".
CRON_SECRET=
# Public URL used in message links (defaults to the Vercel production URL).
APP_URL=
# Email via Resend (free tier): resend.com → API Keys; the from-address must
# be on a domain you've verified in Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# SMS and WhatsApp via Twilio (paid; trial credit available).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
